# Environment Mode (development | production | test)
NODE_ENV=production

# Server Configuration (Use HOST=0.0.0.0 on Hostinger / Cloud PaaS / Docker, or HOST=127.0.0.1 behind local Nginx)
HOST=0.0.0.0
PORT=4000
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_COUNT=1
MAX_VIDEO_UPLOAD_MB=1500
USE_NGINX_ACCEL=false
UV_THREADPOOL_SIZE=16

# Security & Authentication (Required: minimum 32 random characters in production)
JWT_SECRET=
JWT_ISSUER=matn-platform
JWT_AUDIENCE=matn-users
JWT_EXPIRES_IN_SECONDS=7200
STREAM_TICKET_SECRET=

# Primary Database (Hostinger Unlimited Web Hosting MySQL — Default in Production)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_LIMIT=12
DB_SSL=false

# Storage & Optional Local SQLite Fallback (for local dev/tests when DB_CLIENT=sqlite)
STORAGE_DIR=
SQLITE_DB_PATH=
UPLOADS_DIR=
BACKUPS_DIR=

# First-Time Admin Bootstrap (Used only by scripts/setup-admin.js / first boot if DB empty)
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Registration & External Providers (Server-side only, never exposed to client)
# Leave WHATSAPP_API_URL empty on Hostinger so student registration uses voucher_code mode,
# and set BOT_PULL_TOKEN (>= 32 chars) for the Friday Pull-Worker WhatsApp bot on the teacher's laptop.
ALLOW_UNVERIFIED_REGISTRATION=false
BOT_PULL_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WEEKLY_REPORT_DELAY_MS=15000
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
