# رابط المنصة على Hostinger (أو محلياً http://127.0.0.1:4000)
PLATFORM_URL=https://your-hostinger-domain.com

# توكن السحب الموحّد (يجب أن يطابق BOT_PULL_TOKEN في ملف .env على Hostinger وطوله 32 حرفاً على الأقل)
BOT_PULL_TOKEN=replace-with-the-exact-same-32plus-char-BOT_PULL_TOKEN-from-hostinger

# إعدادات الخادم المحلي لصفحة الباركود والمتابعة (Loopback فقط للأمان)
BOT_HOST=127.0.0.1
BOT_PORT=4001

# توقيت الإرسال الآمن ضد حظر واتساب (موصى به: تأخير 12-18 ثانية + استراحة 90 ثانية كل 40 رسالة)
BOT_MIN_DELAY_MS=12000
BOT_JITTER_MS=6000
BOT_BATCH_SIZE=40
BOT_BATCH_COOLDOWN_MS=90000
BOT_POLL_INTERVAL_MS=15000
